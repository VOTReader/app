{
  "name": "votreader-build",
  "version": "1.0.2",
  "description": "Build pipeline for VOTReader's WebView assets (Objective G — bundler + ES modules).",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "python tools/build.py && npm run build:b && npm run build:c && npm run build:d && npm run build:e && npm run build:f && npm run build:css && npm run build:csp && npm run build:sw",
    "build:b": "esbuild app/src/main/assets/src/stores/_entry-b.js --bundle --format=iife --target=chrome108 --minify --outfile=app/src/main/assets/dist/bundle-b.js",
    "build:c": "esbuild app/src/main/assets/src/renderer/_entry.js --bundle --format=iife --target=chrome108 --minify --outfile=app/src/main/assets/dist/bundle-c.js",
    "build:d": "esbuild app/src/main/assets/src/ui/_entry-d.js --bundle --format=iife --target=chrome108 --minify --outfile=app/src/main/assets/dist/bundle-d.js",
    "build:e": "esbuild app/src/main/assets/src/ui/_entry-e.js --bundle --format=iife --target=chrome108 --minify --outfile=app/src/main/assets/dist/bundle-e.js",
    "build:f": "esbuild app/src/main/assets/src/ui/_entry-f.js --bundle --format=iife --target=chrome108 --minify --outfile=app/src/main/assets/dist/bundle-f.js",
    "build:css": "esbuild app/src/main/assets/app.css --minify --target=chrome108 --outfile=app/src/main/assets/dist/app.min.css",
    "build:csp": "node tools/sync-csp-hashes.js",
    "build:sw": "node tools/sync-sw-version.js",
    "check:csp": "node tools/sync-csp-hashes.js --check",
    "typecheck": "tsc --noEmit",
    "lint:globals": "python tools/gen-eslint-globals.py",
    "lint": "npm run lint:globals && eslint app/src/main/assets/src",
    "lint:fix": "npm run lint:globals && eslint app/src/main/assets/src --fix",
    "smoke-lite": "node tools/smoke-lite.js",
    "smoke:ci": "node tools/smoke-ci.js",
    "e2e:read": "node tools/e2e-read-detector.mjs",
    "e2e:readalong": "node tools/e2e-readalong.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "validate:data": "node tools/validate-schemas.js --strict",
    "check:footnotes": "node tools/audit-footnotes.js --check",
    "check:app-size": "node tools/check-app-size.js",
    "check:audio-sync": "node tools/check-audio-sync.js",
    "check:corpus": "node tools/check-corpus-version.js",
    "check:apk-assets": "node tools/check-apk-assets.js",
    "check:type-scale": "node tools/check-type-scale.js",
    "check:css-tokens": "node tools/check-css-tokens.js",
    "check:bundle-budget": "node tools/check-bundle-budget.js",
    "check:runtime-assets": "node tools/list-runtime-src-assets.js --check",
    "check:live": "node tools/check-live-version.js",
    "check:search-index": "node tools/check-search-index-version.js --check",
    "check:asset-integrity": "node tools/check-asset-integrity.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "jsdom": "^30.0.0",
    "lint-staged": "^17.4.1",
    "minisearch": "^7.2.0",
    "puppeteer": "^25.9.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "subset-font": "^2.7.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.7"
  },
  "lint-staged": {
    "app/src/main/assets/src/**/*.{js,jsx}": "eslint --max-warnings 0 --no-warn-ignored"
  },
  "engines": {
    "node": ">=20"
  }
}
