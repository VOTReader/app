<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11-and-below twin of data_extraction_rules.xml's cloud-backup (ds-backup 2026-10-23): the same
     include list, so the same small set goes to Google's backup on every version. Why IndexedDB stays out
     (kept songs, 25 MB cap): see data_extraction_rules.xml. -->
<full-backup-content>
    <include domain="file" path="snapshots/" />
    <include domain="sharedpref" path="plan_reminder.xml" />
</full-backup-content>
