<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Microphone — required for in-app voice recording (journal voice memos).
         Runtime permission is requested via ActivityResultContracts.RequestPermission
         on API 23+. WebChromeClient.onPermissionRequest grants the WebView
         RESOURCE_AUDIO_CAPTURE once the OS grant is in place. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- MODIFY_AUDIO_SETTINGS — a "normal" (non-runtime) permission. WebView's
         internal Chromium audio pipeline calls AudioManager.setMode() when it
         opens an AudioRecord session for getUserMedia. Without this permission
         that call silently no-ops, the audio subsystem stays in the wrong mode,
         AudioRecord fails to acquire the mic, and getUserMedia rejects with
         NotReadableError even though RECORD_AUDIO is granted and no other app
         is recording. Required for in-app voice recording to work on Android. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- VIBRATE — a "normal" (non-runtime) permission. Granted at install
         time. Used by the haptic feedback bridge so the JS layer can fire
         short vibrations on meaningful interactions (bookmark toggle,
         recording complete, etc.) to make the WebView UI feel native. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- FOREGROUND_SERVICE (+ the API 34 per-type twin) — "normal" (non-runtime)
         permissions, granted at install. AudioKeepAliveService anchors the
         PROCESS while an audio letter streams, so a backgrounded reader isn't an
         ordinary kill candidate under memory pressure. FOREGROUND_SERVICE_MEDIA_-
         PLAYBACK is required from targetSdk 34 for a mediaPlayback-typed service
         and is ignored below it.
         POST_NOTIFICATIONS is deliberately NOT declared: it is a runtime prompt,
         the app has a no-nag policy, and it is not required for the service to
         run — on Android 13+ without it the ongoing notification is simply
         hidden while the process anchoring still works. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- usesCleartextTraffic="false" is DOCUMENTATION, not new hardening: with
         targetSdk 36 cleartext has been off by default since targetSdk 28, so
         this changes no behavior. It's here so the guarantee is readable in the
         manifest instead of inferred from an SDK level, and so a future
         targetSdk change can't quietly re-enable it. All app resources load
         from the APK or HTTPS; an http:// link in content leaves via an
         external intent, so it never rides this WebView. -->
    <application
        android:name=".VOTReaderApp"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VotReader.Splash">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="screenSize|orientation|keyboardHidden|smallestScreenSize|uiMode|screenLayout"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Started (never bound) service, launched only from our own process by
             AudioKeepAliveService.setActive — exported="false". -->
        <service
            android:name=".AudioKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

    </application>

</manifest>
