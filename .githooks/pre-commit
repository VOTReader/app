#!/bin/sh
# pre-commit hook — pre-flight checks gated on what's staged (5d runs always):
#
#   1. check_balance.py        when corpus data files change
#      Catches black-screen failure modes that brace-balance alone misses:
#      esprima parse errors, smart-quote delimiters, non-ASCII dashes in
#      verse ranges.
#   1b. validate-schemas.js --strict   when data files OR the validator change
#      (W9.1) Checks the Format A/B/C/D + Holy Days schemas: required
#      fields, block/segment/align types, footnote<->nkjv integrity,
#      prev/next chains, study chapterId resolution — the "valid JS but
#      invalid letter" class that check_balance.py can't see.
#   1c. test_preview_server.py   when tools/preview-server.py or its test changes
#      The preview server must listen on 127.0.0.1 only; it bound every
#      interface until 2026-09-03 and nothing said so. A dev server that
#      can LAN-expose the tree is a defect. CI runs this on every push.
#   1d. test_batch_align_ship.py when tools/batch-align.py or its test changes
#      batch-align.py's ship() rebuilds audio-sync.js from its run report, so
#      a letter that raised — or that align-supervisor.py skipped for memory —
#      used to be deleted from the shipped file. Coverage only goes up.
#   1e. test_align_commit.py    when tools/_alignlib.py, tools/align-supervisor.py
#      or its test changes. commit_gb() must read PrivateUsage from the _EX
#      struct: reading the base struct's PagefileUsage printed 10.02 GB where
#      the truth was 17.29 GB. CI holds the shape; this hook is on Windows so
#      it also compares against an instrument outside the process.
#
#   2. lint-staged (Q3.5)    when any .js/.jsx source file changes
#      Runs `eslint --max-warnings 0` ONLY on staged source files.
#      Mirrors CI's lint gate but in seconds (per-file, not full-repo),
#      so regressions fail at the commit-message prompt — not after push.
#      Config: package.json → "lint-staged" → eslint --max-warnings 0.
#
#   3. tsc --noEmit (Q4.1)   when any .js/.jsx source file changes
#      `npm run typecheck` against tsconfig.json's Q4 scope (utils +
#      stores + hooks). ~3.5s. tsc requires the whole project graph;
#      can't typecheck a single file in isolation, so we run the full
#      project on any source change. Zero-tolerance: any type error
#      fails the commit.
#
#   4. vitest + coverage floors (Q5.1 / C2-D [D1])   when any .js/.jsx source file changes
#      `npm run test:coverage` runs the full vitest suite once WITH the v8
#      coverage floors in vitest.config.js (~66s measured 2026-08-10 for
#      3,941 tests). jsdom environment; React-as-global + window.__* stubs
#      in vitest.setup.js. Zero-tolerance: a failing test OR a floor breach
#      fails the commit. `npm run test` stays coverage-free for the dev loop.
#
#   4b. vitest run tools/     when a tools/*.js|mjs script is staged and no
#      app source is (Step 4 already covers it otherwise). tools/ sits
#      outside tsconfig and the bundle-source list, so a gate script used to
#      reach CI with no local run of its own *.test.js.
#
#   5. python tools/build.py  when any bundle-source file changes
#      Rebuilds dist/bundle-{a,b,c,d}.js and stages the regenerated
#      output so the commit lands with bundles in sync with source.
#      Replaces the "remember to run the build" trap — the hook does
#      it for you. Runs ONLY on commits that touch bundle sources;
#      docs/gradle/plan commits skip it entirely.
#
#   6. gradle test (NK1)     when any .kt or app/build.gradle.kts changes
#      `./gradlew :app:testDebugUnitTest` runs the full Kotlin unit-test
#      suite (JUnit 5 + Robolectric, junit-vintage bridge). Zero-tolerance:
#      any failing Kotlin test fails the commit, same discipline as the
#      JS-side vitest gate. First run ~60s (Gradle daemon cold start);
#      subsequent ~5-10s with the daemon warm.
#
# This file is VERSIONED. To activate, run once per clone:
#   git config core.hooksPath .githooks
# (See CLAUDE.md for the one-line setup.)
#
# Every check except 5d (ASSET_INTEGRITY, unconditional) is skipped
# automatically when no relevant file is staged, so commits to CLAUDE.md /
# PLAN.txt / docs run with almost no delay.

exec 1>&2  # all output to stderr so it appears during commit

# --- Step 0: no fossil hook is shadowing this one (UNCONDITIONAL) -----
# On 2026-09-04 this repo had a 3,694-byte May-20 `.git/hooks/pre-commit`
# sitting beside a 40,325-byte `.githooks/pre-commit`. It never ran, because
# core.hooksPath pointed here -- but it gated two things out of twenty and
# would have printed [pre-commit] lines and exited 0 for anyone who unset
# core.hooksPath or cloned without the install step. A fossil that never runs
# is not harmless; it is a silent downgrade waiting for one config change.
#
# This loops over every name .githooks defines rather than checking
# "pre-commit", because core.hooksPath redirects EVERY hook: add a
# .githooks/pre-push later and a fossil .git/hooks/pre-push is armed with
# nothing to say so. Same code, does not go stale.
#
# It CANNOT catch core.hooksPath being unset -- this file does not run at all
# in that case, and nothing local can. That case is covered by CI, which runs
# the whole gate set on every push independently of any hook. So the exposure
# there is a late failure, not an ungated main.
#
# RED proof, both directions plus a control: sh tools/hook-shadow-guard.test.sh
_gitdir=$(git rev-parse --git-common-dir)
_toplevel=$(git rev-parse --show-toplevel)
for _h in "$_toplevel"/.githooks/*; do
  [ -f "$_h" ] || continue
  _name=${_h##*/}
  if [ -f "$_gitdir/hooks/$_name" ]; then
    echo "[pre-commit] FATAL: $_gitdir/hooks/$_name shadows .githooks/$_name."
    echo "  git runs only the hook core.hooksPath points at, so this file is"
    echo "  inert today -- and takes over silently the moment that is unset."
    echo "  Disable it (do not delete; it may not exist anywhere in history):"
    echo "    mv '$_gitdir/hooks/$_name' '$_gitdir/hooks/$_name.disabled'"
    exit 1
  fi
done

# Detect HEAD (first commit has no HEAD)
if git rev-parse --verify HEAD >/dev/null 2>&1; then
  against=HEAD
else
  against=$(git hash-object -t tree /dev/null)
fi

staged=$(git diff --cached --name-only "$against")

# ─── Step 1: corpus data file validation ────────────────────────────
data_changed=$(echo "$staged" | grep '^app/src/main/assets/src/data/' || true)
# Also run the schema validator when the validator OR its tests change, so a
# regression in tools/validate-schemas.js is caught even on a commit that
# stages no data file.
schema_tool_changed=$(echo "$staged" | grep -E '^tools/validate-schemas' || true)

if [ -n "$data_changed" ]; then
  echo "[pre-commit] Data files changed — running check_balance.py..."
  echo ""
  python check_balance.py
  status=$?
  if [ $status -ne 0 ]; then
    echo ""
    echo "---------------------------------------------------------------"
    echo "Data file validation FAILED — see output above."
    echo "Fix the errors, re-stage the file(s), then retry the commit."
    echo "  git add app/src/main/assets/src/data/<fixed-file>.js"
    echo "  git commit ..."
    echo "---------------------------------------------------------------"
    exit 1
  fi
  echo "[pre-commit] All data files OK."
  echo ""
fi

# ─── Step 1b: schema validation (W9.1 — Format A/B/C/D + Holy Days) ──
# node tools/validate-schemas.js --strict exits nonzero on any schema
# error (missing field, bad block/segment/align type, orphaned footnote
# ref, broken prev/next chain, unresolved study chapterId, …). Runs on
# data changes AND validator changes. Node may not be on the inherited
# PATH on Windows (winget install) — probe known install dirs, same
# pattern as the bundle-rebuild step below.
if [ -n "$data_changed" ] || [ -n "$schema_tool_changed" ]; then
  if ! command -v node >/dev/null 2>&1; then
    for candidate in \
        "/c/Program Files/nodejs" \
        "/c/Program Files (x86)/nodejs" \
        "$LOCALAPPDATA/Programs/Node.js" \
        "$HOME/AppData/Roaming/npm"; do
      if [ -x "$candidate/node" ] || [ -x "$candidate/node.exe" ]; then
        export PATH="$candidate:$PATH"
        break
      fi
    done
  fi
  echo "[pre-commit] Validating data schemas — node tools/validate-schemas.js --strict..."
  node tools/validate-schemas.js --strict
  status=$?
  if [ $status -ne 0 ]; then
    echo ""
    echo "---------------------------------------------------------------"
    echo "Schema validation FAILED — see errors above."
    echo "A data file has a structural error the parser can't catch:"
    echo "missing field, bad block/segment/align type, orphaned footnote"
    echo "ref, broken prev/next chain, or an unresolved study chapterId."
    echo "Fix the errors, re-stage the file(s), then retry the commit."
    echo "Emergency bypass (not recommended): git commit --no-verify"
    echo "---------------------------------------------------------------"
    exit 1
  fi
  echo "[pre-commit] Schema validation OK."
  echo ""
fi

# ─── Step 1b2: read-along offsets address the right characters ──────
# AUDIO_SYNC ships CHARACTER OFFSETS into a block's rendered textContent. That
# domain is defined in the app (segment-dom-text.js) and measured offline by
# the aligner, months apart, so the two can drift silently — and did, by up to
# 13 characters, painting the wash into the previous clause. Nothing saw it:
# smoke.js only checks the row's BLOCK exists, and validate-schemas has no
# AUDIO_SYNC coverage. Fires on any data change (a prose edit can invalidate a
# timing just as a re-align can) and on changes to the gate or the shared
# fragment library it derives the text domain from.
sync_tool_changed=$(echo "$staged" | grep -E '^tools/(check-audio-sync|audio-fragments-lib|extract-audio-fragments)' || true)
if [ -n "$data_changed" ] || [ -n "$sync_tool_changed" ]; then
  echo "[pre-commit] Checking read-along offsets — node tools/check-audio-sync.js..."
  node tools/check-audio-sync.js
  status=$?
  if [ $status -ne 0 ]; then
    echo ""
    echo "---------------------------------------------------------------"
    echo "Read-along offset check FAILED — see output above."
    echo "A shipped span no longer starts and ends on a word boundary, so"
    echo "the highlight would paint mid-word. This is almost always STALE"
    echo "TIMING DATA, not bad prose: re-align the named volumes with"
    echo "  py -3.13 tools/batch-align.py --volkeys <vols>"
    echo "NEVER hand-edit src/data/audio-sync.js — it is generated."
    echo "---------------------------------------------------------------"
    exit 1
  fi
  echo "[pre-commit] Read-along offsets OK."
  echo ""
fi

# ─── Step 1b3: Bible verse timings match corpus, audio and belts ──────
# src/data/bible-sync-<edition>.js is the Bible read-along (verse onsets in
# centiseconds, one slot per verse). check-audio-sync covers the LETTERS only
# and validate-schemas never reads this file, which is how c40 shipped with no
# gate at all. tools/validate-bible-sync.py proves, per chapter: one slot per
# verse of a fresh corpus extract, integer non-negative monotonic onsets, the
# last onset inside the local mp3, the belt current (settings + verses +
# audioSize) and above the ship gate, and the array byte-equal to what ship()
# rebuilds -- plus no current belt silently dropped. Full mode here (this is
# the machine that holds the belts and the audio); CI runs --structural.
# Fires when a timings file, the gate, the pipeline it reads, or a Bible
# translation file is staged: a verse-text edit re-keys every belt it touches.
# A case-only edit is restamped with tools/restamp-bible-belts.py; anything
# else needs a re-align.
bible_sync_changed=$(echo "$staged" | grep -E '^(app/src/main/assets/src/data/bible-(sync-[a-z-]+|kjv|web|asv|bsb|hnv|lsv|ylt)\.js|tools/(validate-bible-sync|batch-align-bible|hone-bible|_alignlib|extract-bible-verses)\.(py|mjs))$' || true)
if [ -n "$bible_sync_changed" ]; then
  echo "[pre-commit] Checking Bible verse timings — tools/validate-bible-sync.py..."
  if command -v py >/dev/null 2>&1; then PYBIN="py -3.13"; else PYBIN="python"; fi
  # --all-editions, because this block's trigger already matches ANY
  # bible-sync-<edition>.js while the command named none: it ran the brm-kjv
  # default. Staging a new edition's timings fired the gate and the gate read a
  # different file and passed.
  $PYBIN tools/validate-bible-sync.py --all-editions
  status=$?
  if [ $status -ne 0 ]; then
    echo ""
    echo "---------------------------------------------------------------"
    echo "Bible verse-timing check FAILED — see output above."
    echo "A chapter in src/data/bible-sync-*.js no longer matches its corpus"
    echo "text, its audio, or its belt. Case-only corpus edits: restamp with"
    echo "  py -3.13 tools/restamp-bible-belts.py --edition brm-kjv --old-data <previous bible-kjv.js> --apply"
    echo "Anything else: re-align the named chapters (tools/batch-align-bible.py)."
    echo "NEVER hand-edit src/data/bible-sync-*.js — it is generated."
    echo "---------------------------------------------------------------"
    exit 1
  fi
  echo "[pre-commit] Bible verse timings OK."
  echo ""
fi

# Every reader who recorded a letter must be OFFERED that letter. The manifest
# is generated, so the failure mode is silent: a composition rule that drops a
# rendition prints a smaller number and nothing else, and the flock's reading
# is gone from the app forever (it happened — the pre-2026-09-04 rules discarded
# any rendition shorter than the primary). node tools/check-audio-manifest.js
# reads the manifest against tools/audio-manifest-coverage.json, which the
# generator writes from its MAPPING stage, so a loss in the COMPOSITION stage
# is visible. Offline and ~0.1 s; no Drive listing, no network.
manifest_changed=$(echo "$staged" | grep -E '^(app/src/main/assets/src/data/audio-manifest\.js|tools/(audio-manifest-coverage\.json|audio-renditions-lib|check-audio-manifest|gen-audio-manifest))' || true)
if [ -n "$manifest_changed" ]; then
  echo "[pre-commit] Checking audio renditions — node tools/check-audio-manifest.js..."
  node tools/check-audio-manifest.js
  status=$?
  if [ $status -ne 0 ]; then
    echo ""
    echo "---------------------------------------------------------------"
    echo "Audio rendition check FAILED — see output above."
    echo "A reading the flock made can no longer be reached in the app, or"
    echo "the manifest and its coverage file disagree. Regenerate both with"
    echo "  node tools/gen-audio-manifest.mjs"
    echo "(needs tools/_audio-drive-listing.json — refresh it with"
    echo " python tools/fetch-drive-audio.py). NEVER hand-edit"
    echo "src/data/audio-manifest.js or audio-manifest-coverage.json."
    echo "---------------------------------------------------------------"
    exit 1
  fi
  echo "[pre-commit] Audio renditions OK."
  echo ""
fi

# ─── Step 1c: data-gate self-test (T6) ──────────────────────────────
# When the data gate itself (check_balance.py) or its test changes, run the
# gate's unit tests so a regression in the GATE — the front-line black-screen
# / white-verse detector — fails at the commit prompt rather than silently
# ceasing to catch the bug class it exists for. Stdlib unittest, no dep beyond
# esprima (already used by Step 1). python is assumed on PATH (Step 1 invokes
# it directly).
gate_changed=$(echo "$staged" | grep -E '^(check_balance\.py|test_check_balance\.py)$' || true)

if [ -n "$gate_changed" ]; then
  echo "[pre-commit] Data gate changed — running test_check_balance.py (T6)..."
  python -m unittest test_check_balance
  status=$?
  if [ $status -ne 0 ]; then
    echo ""
    echo "---------------------------------------------------------------"
    echo "Data-gate self-test FAILED — check_balance.py logic regressed."
    echo "Fix it (or the test), re-stage, then retry the commit."
    echo "Emergency bypass (not recommended): git commit --no-verify"
    echo "---------------------------------------------------------------"
    exit 1
  fi
  echo "[pre-commit] Data-gate tests OK."
  echo ""
fi

# The scheduled audio pipeline's Python dependencies must stay declared and
# pinned. The weekly Task Scheduler job runs fetch-drive-audio ->
# gen-audio-manifest -> mirror-audio-release unattended, so an undeclared
# import is a ModuleNotFoundError at step 1 and audio ingestion stops
# indefinitely against a green repo (process-hygiene-6, 2026-09-04). Fires when
# a requirements file or ANY Python file is staged.
#
# It used to enumerate the scheduled-path scripts here, which made this line a
# second copy of the file lists inside test_requirements.py — and the two had
# already drifted: the enumeration missed check_balance.py, which is IN
# SCHEDULED_PATH, and all four OCR consumers the test reads. Same shape as
# tests-gates-6: a trigger that cannot match its own file. Naming the file TYPE
# instead of the files removes the list that had to be kept in sync. The test is
# stdlib-only and parses nine files with `ast`; it runs in under 0.2 s, so
# there is nothing here worth gating against.
reqs_changed=$(echo "$staged" | grep -E '\.py$|^requirements-(dev|ocr)\.txt$' || true)
if [ -n "$reqs_changed" ]; then
  echo "[pre-commit] Checking the scheduled pipeline's Python pins (test_requirements.py)..."
  python -m unittest test_requirements
  status=$?
  if [ $status -ne 0 ]; then
    echo ""
    echo "---------------------------------------------------------------"
    echo "Dependency pin check FAILED — see output above."
    echo "A script on the SCHEDULED path imports something requirements-dev.txt"
    echo "does not pin. The weekly audio job runs unattended, so that is a"
    echo "silent stop, not a warning. Add the pin (measured version, with a"
    echo "comment naming the consumer), or move the import off that path."
    echo "OCR-only dependencies belong in requirements-ocr.txt."
    echo "---------------------------------------------------------------"
    exit 1
  fi
  echo "[pre-commit] Dependency pins OK."
  echo ""
fi

# ─── Step 1c: the preview server's bind contract ────────────────────
# tools/preview-server.py must listen on 127.0.0.1 only (test_preview_server.py
# spawns it and proves the LAN address refuses). Runs whenever the server or
# the test itself is staged; ci.yml runs it on every push beside
# test_check_balance.
preview_changed=$(echo "$staged" | grep -E '^(tools/preview-server\.py|test_preview_server\.py)$' || true)
if [ -n "$preview_changed" ]; then
  echo "[pre-commit] Preview server changed — proving it binds loopback only (test_preview_server.py)..."
  python -m unittest test_preview_server
  status=$?
  if [ $status -ne 0 ]; then
    echo ""
    echo "---------------------------------------------------------------"
    echo "Preview-server bind test FAILED — the server must listen on"
    echo "127.0.0.1 only. Fix tools/preview-server.py, re-stage, then retry."
    echo "---------------------------------------------------------------"
    exit 1
  fi
  echo "[pre-commit] Preview server binds loopback only."
  echo ""
fi

# ─── Step 1d: the read-along shipper never deletes what it did not run ───
# tools/batch-align.py rebuilds src/data/audio-sync.js volume by volume from its
# run report, so a letter that RAISED or that tools/align-supervisor.py skipped
# for exceeding the RSS ceiling used to be DELETED from the shipped file — one
# crash or one memory spike became a silent coverage regression, and every gate
# stayed green because they all validate the rows that ARE present.
# test_batch_align_ship.py proves the carry-forward AND the two deliberate drops
# (below the ship gate, gone from the manifest), so it cannot rot into a shipper
# that never deletes anything. ci.yml runs it on every push beside
# test_check_balance.
ship_changed=$(echo "$staged" | grep -E '^(tools/batch-align\.py|test_batch_align_ship\.py)$' || true)
if [ -n "$ship_changed" ]; then
  echo "[pre-commit] Read-along shipper changed — running test_batch_align_ship.py..."
  python -m unittest test_batch_align_ship
  status=$?
  if [ $status -ne 0 ]; then
    echo ""
    echo "---------------------------------------------------------------"
    echo "Shipper carry-forward test FAILED — batch-align.py's ship() must"
    echo "keep the timings of a unit its run produced no result for, and"
    echo "must still drop an EXCLUDED one and one gone from the manifest."
    echo "---------------------------------------------------------------"
    exit 1
  fi
  echo "[pre-commit] Shipper carries forward unrun units."
  echo ""
fi

# ─── Step 1e: the commit-charge reader (2026-09-05) ────────────────
# Both alignment runners print a per-unit COMMIT charge, and align-supervisor.py
# records it beside RSS when it kills a unit. The reader took PagefileUsage from
# the BASE PROCESS_MEMORY_COUNTERS; the commit charge is PrivateUsage, which
# only exists in the _EX struct. It printed 10.02 GB against a true 17.29 GB
# that three external instruments agreed on — 40% low, and plausible, which is
# worse than a zero because a zero is obviously broken. Machine Ops was sizing a
# ceiling off that series. Unlike CI's ubuntu runner this hook is on Windows, so
# BOTH halves run here: the shape of the struct and the live comparison against
# Win32_Process PrivatePageCount for this very process. ~0.5s.
mem_changed=$(echo "$staged" | grep -E '^(tools/_alignlib\.py|tools/align-supervisor\.py|test_align_commit\.py)$' || true)
if [ -n "$mem_changed" ]; then
  echo "[pre-commit] Memory instrumentation changed — running test_align_commit.py..."
  python -m unittest test_align_commit
  status=$?
  if [ $status -ne 0 ]; then
    echo ""
    echo "---------------------------------------------------------------"
    echo "Commit-charge reader FAILED — commit_gb() must read PrivateUsage"
    echo "from the PROCESS_MEMORY_COUNTERS_EX struct, and must agree with"
    echo "an instrument outside the process. A near-miss field reads like a"
    echo "real number and silently under-reports what this job costs the"
    echo "rest of the machine."
    echo "---------------------------------------------------------------"
    exit 1
  fi
  echo "[pre-commit] Commit charge agrees with an external instrument."
  echo ""
fi

# ─── Step 2: lint staged source files (Q3.5) ───────────────────────
# Mirrors CI's `npm run lint -- --max-warnings 0` gate but only on
# staged files. Sub-second on typical commits; fails fast at the commit
# prompt instead of after push.
src_changed=$(echo "$staged" | grep -E '^app/src/main/assets/src/.*\.(js|jsx)$' || true)

if [ -n "$src_changed" ]; then
  echo "[pre-commit] Source files staged — running lint-staged..."
  # Probe for npm on the path (winget-installed Node may not be on the
  # inherited PATH — mirrors the bundle-rebuild step's fallback).
  if ! command -v npm >/dev/null 2>&1; then
    for candidate in \
        "/c/Program Files/nodejs" \
        "/c/Program Files (x86)/nodejs" \
        "$LOCALAPPDATA/Programs/Node.js" \
        "$HOME/AppData/Roaming/npm"; do
      if [ -x "$candidate/npm" ] || [ -x "$candidate/npm.cmd" ]; then
        export PATH="$candidate:$PATH"
        break
      fi
    done
  fi
  # B1: regenerate the cross-bundle globals list FIRST, then re-stage it. A new
  # top-level UPPER_CASE decl in src/data/ (or a newly window-exposed export)
  # shifts this generated list. The per-file lint-staged below still passes on
  # stale globals, but CI's smoke-lite globals-mirror check then fails AFTER
  # push (exactly what BOOK_ALIASES did). Regenerating + staging here closes the
  # gap noted in [[globals-regen-workflow]]. (gen-eslint-globals.py is Python,
  # already on PATH from Step 1; the generator is idempotent — a no-op stages
  # nothing.)
  npm run lint:globals >/dev/null 2>&1
  git add tools/eslint-globals.generated.js tools/globals.generated.d.ts
  npx lint-staged
  status=$?
  if [ $status -ne 0 ]; then
    echo ""
    echo "---------------------------------------------------------------"
    echo "Lint failed — see eslint output above."
    echo "Fix the warnings/errors, re-stage the file(s), then retry."
    echo "Emergency bypass (not recommended): git commit --no-verify"
    echo "---------------------------------------------------------------"
    exit 1
  fi
  echo "[pre-commit] Lint OK."
  echo ""

  # ─── Step 3: typecheck (Q4.1) ─────────────────────────────────────
  # Source files changed → run tsc --noEmit against the Q4 scope.
  # Reuses the npm path probe from above. ~3.5s for the full project.
  echo "[pre-commit] Source files staged — running tsc --noEmit (Q4 scope)..."
  npm run typecheck
  status=$?
  if [ $status -ne 0 ]; then
    echo ""
    echo "---------------------------------------------------------------"
    echo "Typecheck FAILED — see tsc output above."
    echo "Fix the type errors, re-stage the file(s), then retry."
    echo "Emergency bypass (not recommended): git commit --no-verify"
    echo "---------------------------------------------------------------"
    exit 1
  fi
  echo "[pre-commit] Typecheck OK."
  echo ""

  # ─── Step 4: vitest run + coverage floor (Q5.1 / C2-D [D1]) ───────
  # Source files changed → run the full vitest suite. Zero-tolerance on a
  # failing test AND on the coverage floors in vitest.config.js.
  #
  # This used to run the coverage-free `npm run test`, so the floors were
  # enforced ONLY in CI — a collapse in the covered tier (a suite deleted, a
  # module silently unimported) reached main and failed after push instead of
  # at the commit prompt. `test:coverage` is the same suite plus the v8
  # instrumentation: measured 2026-08-10 at 66s vs 47s for 3,941 tests, on a
  # commit that already pays for a bundle rebuild. `npm run test` stays
  # coverage-free for watch/dev so the fast loop is untouched.
  echo "[pre-commit] Source files staged — running vitest (with coverage floors)..."
  npm run test:coverage
  status=$?
  if [ $status -ne 0 ]; then
    echo ""
    echo "---------------------------------------------------------------"
    echo "Tests OR the coverage floor FAILED — see vitest output above."
    echo "A coverage line under its threshold means the covered tier (hooks/"
    echo "stores/utils/renderer/search) LOST ground — find the suite or module"
    echo "that stopped running. The floors sit ~25 points under measured, so"
    echo "they only trip on a collapse; never lower one to make this pass."
    echo "Fix the failing tests, re-stage the file(s), then retry."
    echo "Emergency bypass (not recommended): git commit --no-verify"
    echo "---------------------------------------------------------------"
    exit 1
  fi
  echo "[pre-commit] Tests OK."
  echo ""

  # ─── App() size budget (P11 canary) ──────────────────────────────
  # If app.jsx itself is staged, enforce its line budget — the composition
  # root must stay decomposed (new concerns belong in src/hooks/, not
  # inlined). Catches the drift class lint/type/test/build don't: app.jsx
  # crept 797->838 lines unnoticed before this gate existed.
  app_jsx_changed=$(echo "$staged" | grep -E '^app/src/main/assets/src/app\.jsx$' || true)
  if [ -n "$app_jsx_changed" ]; then
    npm run check:app-size
    status=$?
    if [ $status -ne 0 ]; then
      echo ""
      echo "---------------------------------------------------------------"
      echo "App() size budget exceeded — extract a concern into src/hooks/."
      echo "Emergency bypass (not recommended): git commit --no-verify"
      echo "---------------------------------------------------------------"
      exit 1
    fi
    echo "[pre-commit] App() size OK."
    echo ""
  fi
fi

# ─── Step 4b: a gate script's own tests (tools/*.test.js) ──────────
# tools/ sits outside tsconfig.json and the bundle-source list, so a commit
# that stages only a gate script (check-*.js, sync-*.js, smoke-*.js) reached
# CI with no local run of the script's *.test.js suite — the very scripts
# that catch silent regressions elsewhere. Step 4 already ran the whole
# suite when app source changed; otherwise run just tools/.
tools_changed=$(echo "$staged" | grep -E '^tools/.*\.(js|mjs)$' || true)
if [ -n "$tools_changed" ] && [ -z "$src_changed" ]; then
  if ! command -v npx >/dev/null 2>&1; then
    for candidate in \
        "/c/Program Files/nodejs" \
        "/c/Program Files (x86)/nodejs" \
        "$LOCALAPPDATA/Programs/Node.js" \
        "$HOME/AppData/Roaming/npm"; do
      if [ -x "$candidate/npx" ] || [ -x "$candidate/npx.cmd" ]; then
        export PATH="$candidate:$PATH"
        break
      fi
    done
  fi
  echo "[pre-commit] tools/ script staged — running the tools/ vitest suite..."
  npx vitest run tools/
  status=$?
  if [ $status -ne 0 ]; then
    echo ""
    echo "---------------------------------------------------------------"
    echo "A tools/ test FAILED — see vitest output above."
    echo "Fix the gate script or its test, re-stage, then retry the commit."
    echo "---------------------------------------------------------------"
    exit 1
  fi
  echo "[pre-commit] tools/ tests OK."
  echo ""
fi

# ─── Step 5: bundle rebuild + SW cache version ──────────────────────
# Any change to a bundled source OR a core-cached asset (app.css,
# index.html) means dist/bundle-*.js and/or the SW's content-hash
# CACHE_VERSION is stale. `npm run build` rebuilds the bundles AND
# re-derives CACHE_VERSION from the core-asset hash (build:sw), so we
# re-stage the bundles + service-worker.js together. Triggers:
#   - app/src/main/assets/src/**/*.{js,jsx}  (all extracted modules)
#   - search.js, search-data.js, flexsearch.min.js
#   - react.min.js, react-dom.min.js, html2canvas.min.js
#   - app.css, index.html  (core-cached → feed the SW content hash)
# manifest.json + offline.html + service-worker.js were added 2026-08-11.
# The first two are not bundle SOURCES, but they ARE in the service worker's
# ASSET_INTEGRITY map, so editing one without re-running build:sw leaves the map
# expecting the old bytes — which fails install-time verification for EVERY client.
# service-worker.js is here for a sharper reason: it was matched by NO trigger, so a
# commit touching only it (a hand-edited CORE_ASSETS list, a routing tweak, this very
# change) ran no build, no map regeneration, no re-stage, and not even lint or the
# tests. The one file whose staleness can stop every client from updating was the one
# file the hook ignored. Now any edit to it runs the whole battery.
bundle_source_changed=$(echo "$staged" | grep -E '^app/src/main/assets/(src/.*\.js|src/.*\.jsx|search\.js|search-data\.js|flexsearch\.min\.js|react\.min\.js|react-dom\.min\.js|html2canvas\.min\.js|app\.css|index\.html|manifest\.json|offline\.html|service-worker\.js)$' || true)

if [ -n "$bundle_source_changed" ]; then
  echo "[pre-commit] Bundle source files changed — rebuilding dist/bundle-*.js..."
  # `npm run build` chains both bundlers in one command:
  #   1. python tools/build.py  → bundle-a.js (classic-script concat)
  #   2. esbuild                → bundle-b.js (G.2.2), bundle-c.js (G.2.1), bundle-d.js (G.2.3)
  # All four must succeed before we stage.
  #
  # All four bundles rebuild + re-stage every time, so a commit can include
  # changes to bundles whose source you did not edit — the hook normalizes
  # any previously-stale bundle here. That extra diff is intentional.
  #
  # Node is required on PATH for the esbuild half. The original assumption
  # was that git-bash on Windows inherits the system PATH containing
  # C:\Program Files\nodejs (the winget install location). In practice
  # that's not always true — winget installs don't refresh PATH for
  # already-running shells, and git-bash invoked from File Explorer /
  # an IDE inherits the parent process's PATH, which may pre-date the
  # Node install. So we probe known install locations and prepend the
  # first one that exists.
  if ! command -v npm >/dev/null 2>&1; then
    for candidate in \
        "/c/Program Files/nodejs" \
        "/c/Program Files (x86)/nodejs" \
        "$LOCALAPPDATA/Programs/Node.js" \
        "$HOME/AppData/Roaming/npm"; do
      if [ -x "$candidate/npm" ] || [ -x "$candidate/npm.cmd" ]; then
        export PATH="$candidate:$PATH"
        echo "[pre-commit] Added $candidate to PATH (npm not on inherited PATH)"
        break
      fi
    done
  fi
  npm run build
  status=$?
  if [ $status -ne 0 ]; then
    echo ""
    echo "---------------------------------------------------------------"
    echo "Bundle rebuild FAILED — see output above."
    echo "If npm or node is missing, install Node LTS from nodejs.org"
    echo "(or via winget install OpenJS.NodeJS.LTS) and try again."
    echo "Fix the build error, re-stage, then retry the commit."
    echo "---------------------------------------------------------------"
    exit 1
  fi
  # Stage the regenerated bundles + the re-versioned SW so the commit
  # lands with everything in sync.
  # Stage ALL seven bundles, incl. the lazy corpus bundles (a-bible /
  # a-matthew / a-vot) — a data-file edit (books.js, matthew.js, a VOT
  # corpus) regenerates those, and they're tracked, so they must be
  # re-staged or the committed bundle goes stale (CI bundle-match fails +
  # the app ships old data). `git add` of an unchanged bundle is a no-op,
  # so listing them is safe on non-corpus commits.
  git add app/src/main/assets/dist/bundle-a.js \
          app/src/main/assets/dist/bundle-a-bible.js \
          app/src/main/assets/dist/bundle-a-matthew.js \
          app/src/main/assets/dist/bundle-a-vot.js \
          app/src/main/assets/dist/bundle-b.js \
          app/src/main/assets/dist/bundle-c.js \
          app/src/main/assets/dist/bundle-d.js \
          app/src/main/assets/dist/bundle-e.js \
          app/src/main/assets/dist/bundle-f.js \
          app/src/main/assets/dist/app.min.css \
          app/src/main/assets/index.html \
          app/src/main/assets/service-worker.js
  # index.html is re-staged because `npm run build` runs build:csp, which
  # re-derives the CSP script-src sha256 allow-list from index.html's inline
  # <script> blocks (U10). If an inline script changed, the hashes are rewritten
  # here — re-stage so the commit lands with the CSP in sync (mirrors bundles/SW).
  echo "[pre-commit] Bundles + CSP hashes + SW cache version regenerated and staged."

  # ─── Step 5a2: type-scale gate ────────────────────────────────────
  # Every font-size must name a --fs-N / --fsc-N token from the single
  # ladder in app.css :root (the app had 103 hand-picked sizes before
  # 2026-08-04). A literal rem/px font-size fails the commit.
  echo "[pre-commit] Checking the type scale (one ladder, no literals)..."
  node tools/check-type-scale.js
  status=$?
  if [ $status -ne 0 ]; then
    echo ""
    echo "---------------------------------------------------------------"
    echo "TYPE-SCALE gate FAILED — replace the literal font-size with a"
    echo "--fs-N token (or --fsc-N for pinned chrome). If the size you need"
    echo "genuinely isn't on the ladder, add the step in app.css :root."
    echo "---------------------------------------------------------------"
    exit 1
  fi

  # ─── Step 5a2b: CSS custom-property gate (C2-D [D8]) ──────────────
  # A `var(--name)` with no fallback and no declaration does not degrade —
  # the whole declaration is invalid at computed-value time and drops.
  # --border shipped that way 13 times and never painted a single border.
  echo "[pre-commit] Checking CSS custom-property references..."
  node tools/check-css-tokens.js
  status=$?
  if [ $status -ne 0 ]; then
    echo ""
    echo "---------------------------------------------------------------"
    echo "CSS-TOKENS gate FAILED — declare the property in app.css :root"
    echo "(plus its body.light twin), or give every reference a fallback."
    echo "---------------------------------------------------------------"
    exit 1
  fi

  # ─── Step 5a3: bundle byte budget (C2-D [D3]) ─────────────────────
  # Runs AFTER the rebuild above, against the bundles just regenerated +
  # staged. Nothing watched dist/ bytes before this, and bundle-d/-e grew
  # ~70%/~110% past their documented sizes unnoticed. Ceilings sit ~15% over
  # the measured baseline — a collapse detector, not a diet.
  echo "[pre-commit] Checking the dist/ byte budget..."
  node tools/check-bundle-budget.js
  status=$?
  if [ $status -ne 0 ]; then
    echo ""
    echo "---------------------------------------------------------------"
    echo "BUNDLE BUDGET gate FAILED — see the named bundle above. Find what"
    echo "got pulled in before assuming the ceiling is stale; re-baselining"
    echo "means editing tools/check-bundle-budget.js in this same commit."
    echo "---------------------------------------------------------------"
    exit 1
  fi

  # ─── Step 5b: CORPUS_VERSION gate (U3) ────────────────────────────
  # The lazy corpus bundles (a-bible/matthew/vot) are SW-cached and busted
  # ONLY by a manual CORPUS_VERSION bump (CACHE_VERSION excludes them). This
  # gate FAILS the commit if their bytes changed without a bump — so existing
  # web clients can't be silently left on stale scripture. It auto-updates +
  # stages tools/corpus-version.lock when CORPUS_VERSION was correctly bumped.
  echo "[pre-commit] Checking CORPUS_VERSION vs corpus-bundle hash (U3)..."
  node tools/check-corpus-version.js
  status=$?
  if [ $status -ne 0 ]; then
    echo ""
    echo "---------------------------------------------------------------"
    echo "CORPUS_VERSION gate FAILED — see message above. Bump CORPUS_VERSION"
    echo "in app/src/main/assets/service-worker.js, rebuild, then retry."
    echo "Emergency bypass (not recommended): git commit --no-verify"
    echo "---------------------------------------------------------------"
    exit 1
  fi
  git add tools/corpus-version.lock

  # ─── Step 5b2: search-index version gate ──────────────────────────
  # The built MiniSearch index is persisted to IndexedDB (~21 MB) and keyed by
  # dataSignature(), which folds in MS_INDEX_VERSION but NOT the search code. So
  # changing the doc shape / indexed fields / tokenizer left every existing client
  # restoring an index the new builder would never produce — and because it lives
  # in IndexedDB, neither a hard reload nor clearing Cache Storage dislodges it.
  # cache.js asked for a manual bump; nothing enforced it until this gate.
  echo "[pre-commit] Checking MS_INDEX_VERSION vs index-shaping code..."
  node tools/check-search-index-version.js
  status=$?
  if [ $status -ne 0 ]; then
    echo ""
    echo "---------------------------------------------------------------"
    echo "SEARCH-INDEX gate FAILED — see message above. Bump MS_INDEX_VERSION"
    echo "in app/src/main/assets/src/search/cache.js, then retry."
    echo "Emergency bypass (not recommended): git commit --no-verify"
    echo "---------------------------------------------------------------"
    exit 1
  fi
  git add tools/search-index-version.lock

  # ─── Step 5b3: runtime src/ asset staging gate ─────────────────────
  # deploy-web.yml excludes src/ (it is bundled) and copies a few runtime-loaded
  # files back in. That copy-back was a hand-written glob and silently dropped
  # src/data/scripture-web-data.js (2.6 MB), which would have 404'd live while
  # working perfectly in local preview. The list is now derived from the loaders.
  echo "[pre-commit] Checking runtime src/ assets are derivable..."
  node tools/list-runtime-src-assets.js --check
  status=$?
  if [ $status -ne 0 ]; then
    echo ""
    echo "---------------------------------------------------------------"
    echo "RUNTIME-ASSET gate FAILED — see message above. A file the app loads at"
    echo "runtime from src/ is missing, or service-worker.js precaches a src/ path"
    echo "no loader references (which means the deploy would drop it)."
    echo "Emergency bypass (not recommended): git commit --no-verify"
    echo "---------------------------------------------------------------"
    exit 1
  fi

fi

# ─── Step 5c: packaged-APK asset gate (UNCONDITIONAL) ───────────────
# ignoreAssetsPatterns (app/build.gradle.kts) is basename-matched with no
# negative-include, so it is easy to exclude an asset the app injects at
# RUNTIME (<script src="src/data/...">) rather than via index.html. That
# already shipped once: `<dir>src` dropped the nine alternate Bible
# translations + bible-studies.js from the APK, and the loader's onerror
# made it fail SILENTLY (every translation fell back to NKJV).
#
# Unconditional, like Step 5d, and for the same reason: this gate reads
# app/build.gradle.kts, and until 2026-09-04 it sat inside the bundle-source
# branch, whose trigger is anchored to app/src/main/assets/ and so cannot
# match app/build.gradle.kts at all. Editing ignoreAssetsPatterns — the one
# file the gate exists to police — armed nothing. It runs in well under a
# second, so there is nothing to buy by gating it on a trigger.
echo "[pre-commit] Checking packaged-APK assets vs runtime injections..."
node tools/check-apk-assets.js
status=$?
if [ $status -ne 0 ]; then
  echo ""
  echo "---------------------------------------------------------------"
  echo "APK ASSET gate FAILED — see message above. Narrow the pattern in"
  echo "app/build.gradle.kts so the runtime-injected file still ships."
  echo "Emergency bypass (not recommended): git commit --no-verify"
  echo "---------------------------------------------------------------"
  exit 1
fi

# ─── Step 5d: ASSET_INTEGRITY truth check (UNCONDITIONAL) ───────────
# Runs on EVERY commit, deliberately outside the bundle-rebuild branch above.
#
# service-worker.js refuses to install a build whose bytes disagree with its
# generated ASSET_INTEGRITY map, so a STALE map does not mean "slightly wrong" — it
# means NO CLIENT CAN UPDATE. The map is written by tools/sync-sw-version.js during
# a build, and the two files are not bound together: a commit could carry the worker
# (with the map and the check) while the generator that maintains it stayed behind,
# after which every build silently leaves the map describing the PREVIOUS bundles.
# `git diff --exit-code service-worker.js` cannot see that — the old generator
# reproduces the committed file exactly, so there is no diff to find.
#
# This gate re-derives the hashes from the assets themselves and never asks what
# wrote the map, only whether it is TRUE. Unconditional because the failure it
# catches can arrive via a commit that touches none of the trigger paths.
echo "[pre-commit] Verifying ASSET_INTEGRITY matches the assets on disk..."
node tools/check-asset-integrity.js
status=$?
if [ $status -ne 0 ]; then
  echo ""
  echo "---------------------------------------------------------------"
  echo "ASSET_INTEGRITY gate FAILED — see message above. The service worker"
  echo "would refuse to install this build on every client. Run:"
  echo "  npm run build"
  echo "then re-stage app/src/main/assets/service-worker.js and retry."
  echo "Emergency bypass (not recommended): git commit --no-verify"
  echo "---------------------------------------------------------------"
  exit 1
fi

# ─── Step 6: gradle test (NK1) ──────────────────────────────────────
# Any change to a .kt source file or the app/build.gradle.kts means the
# Kotlin unit-test suite needs to run. Mirrors the JS-side vitest gate
# in zero-tolerance discipline. First run cold-starts the Gradle daemon
# (~60s); subsequent runs are ~5-10s with the daemon warm.
#
# We test on test-source changes too — a flaky test file or a new test
# that breaks the suite should fail at the commit prompt, not in CI.
kotlin_changed=$(echo "$staged" | grep -E '^(app/src/(main|test)/.*\.kt|app/src/main/AndroidManifest\.xml|app/src/main/res/.*|app/build\.gradle\.kts|gradle/libs\.versions\.toml)$' || true)

if [ -n "$kotlin_changed" ]; then
  echo "[pre-commit] Kotlin sources or gradle config changed — running ./gradlew :app:testDebugUnitTest..."
  if [ -x ./gradlew ]; then
    GRADLE_CMD="./gradlew"
  elif command -v gradle >/dev/null 2>&1; then
    GRADLE_CMD="gradle"
  else
    echo "---------------------------------------------------------------"
    echo "Neither ./gradlew nor gradle on PATH. Cannot run Kotlin tests."
    echo "If you intentionally do not have Gradle locally, use:"
    echo "  git commit --no-verify"
    echo "and the CI gate will catch any test failures on push."
    echo "---------------------------------------------------------------"
    exit 1
  fi
  $GRADLE_CMD :app:testDebugUnitTest :app:jacocoTestCoverageVerification
  status=$?
  if [ $status -ne 0 ]; then
    echo ""
    echo "---------------------------------------------------------------"
    echo "Kotlin tests OR coverage gate FAILED — see gradle output above."
    echo "HTML test report: app/build/reports/tests/testDebugUnitTest/index.html"
    echo "HTML coverage report:"
    echo "  app/build/reports/jacoco/jacocoTestReport/html/index.html"
    echo "  (run \`./gradlew :app:jacocoTestReport\` first if missing)"
    echo "Fix the failing tests, re-stage, then retry the commit."
    echo "Emergency bypass (not recommended): git commit --no-verify"
    echo "---------------------------------------------------------------"
    exit 1
  fi
  echo "[pre-commit] Kotlin tests + coverage gate OK."
fi

exit 0
