# Normalize line endings. Store LF in the repo AND check out LF in the
# working tree everywhere (eol=lf), so Windows and Linux/CI agree
# byte-for-byte. This keeps the content-hash SW cache version (build:sw)
# stable cross-platform and ends the "LF will be replaced by CRLF" warnings.
* text=auto eol=lf

# Binary assets — never apply text/EOL normalization (would corrupt them).
*.jar      binary
*.woff2    binary
*.ttf      binary
*.otf      binary
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.webp     binary
*.ico      binary
*.onnx     binary
*.wasm     binary
*.bin      binary
*.pdf      binary
*.zip      binary
*.keystore binary
*.jks      binary
*.lnk      binary

# Generated output merges without hand-resolving (network ln1 item 5, 2026-10-05). Drivers live in git config:
# run `sh tools/install-merge-drivers.sh` once per clone (worktrees share it). Without them git merges as text.
# dist/ and the generated globals: keep ours; the next build (land.sh rebuilds after every rebase) rewrites them.
app/src/main/assets/dist/** merge=votgen-ours
tools/*.generated.* merge=votgen-ours
# Hand-written files with generated lines: merged with CACHE_VERSION / ASSET_INTEGRITY / CSP hashes masked.
app/src/main/assets/service-worker.js merge=votgen-sw
app/src/main/assets/index.html merge=votgen-sw
